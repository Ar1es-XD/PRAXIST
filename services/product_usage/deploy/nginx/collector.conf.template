server {
    listen 80;
    server_name __COLLECTOR_HOST__;
    server_tokens off;

    access_log off;
    error_log /dev/null crit;
    client_body_timeout 5s;
    client_max_body_size 32k;
    limit_req_status 429;
    error_page 413 = @request_too_large;
    error_page 429 = @rate_limited;

    location @request_too_large {
        default_type application/json;
        return 413 '{"error":"request_too_large"}';
    }

    location @rate_limited {
        default_type application/json;
        return 429 '{"error":"rate_limited"}';
    }

    location = /healthz {
        proxy_pass http://127.0.0.1:8110/healthz;
        proxy_connect_timeout 3s;
        proxy_read_timeout 3s;
        proxy_set_header X-Forwarded-For "";
        proxy_set_header X-Real-IP "";
    }

    location = /v1/events {
        limit_req zone=praxist_collector burst=10 nodelay;
        limit_req zone=praxist_collector_global burst=100 nodelay;
        proxy_pass http://127.0.0.1:8110/v1/events;
        proxy_connect_timeout 3s;
        proxy_read_timeout 10s;
        proxy_set_header Cookie "";
        proxy_set_header User-Agent "";
        proxy_set_header X-Forwarded-For "";
        proxy_set_header X-Real-IP "";
    }

    location / {
        return 404;
    }
}
